<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      MANAGE_EXTERNAL_STORAGE, as the Android CrossPoint: the PC's disk
      images, the C64's games and the Mac's discs live in a folder of plain
      files (/sdcard/RetroComputer), read and written in place through
      POSIX, as the cores do on the boards' cards. The user grants it in
      Settings, Special app access; without it the app still runs the MSX
      and the Spectrum, which need no files.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar.Fullscreen">

        <!--
          No screenOrientation here: RetroActivity notes the orientation the
          system was in, then asks for sensorLandscape (these are keyboard
          computers, and every one of them drew a landscape picture), and
          gives the noted one back on the way out. The Boox kept the app's
          landscape after it, for its own home screen. configChanges keeps
          the Activity (and the
          Surface) through a keyboard being connected or the panel turning,
          as in the Android CrossPoint: on e-ink a recreated window is a
          flashing screen for nothing.
        -->
        <activity
            android:name=".RetroActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
