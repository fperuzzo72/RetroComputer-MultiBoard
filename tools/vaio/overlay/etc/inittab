# /etc/inittab - Alpine's, but tty1 runs the RetroComputer (/etc/retro/start)
# logged in as root, with no prompt; tty2 is a login for looking around.

::sysinit:/sbin/openrc sysinit
::sysinit:/sbin/openrc boot
::wait:/sbin/openrc default

tty1::respawn:/sbin/getty -n -l /etc/retro/start 38400 tty1
tty2::respawn:/sbin/getty 38400 tty2

::ctrlaltdel:/sbin/poweroff
::shutdown:/sbin/openrc shutdown
